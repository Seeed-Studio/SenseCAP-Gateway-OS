sed -i '/chirpstack/d' /etc/apk/repositories.d/distfeeds.list
sed -i '/lorawan_gateway/d' /etc/apk/repositories.d/distfeeds.list
sed -i '/luci_lorawan_gateway/d' /etc/apk/repositories.d/distfeeds.list

exit 0
