{
    "admin/network/wireless": {
        "title": "Wi-Fi",
        "order": 40,
        "action": {
            "type": "view",
            "path": "network/wireless"
        },
        "depends": {
            "acl": [
                "luci-mod-network-config"
            ],
            "uci": {
                "wireless": {
                    "@wifi-device": true
                }
            }
        }
    },
    "admin/network/network": {
        "title": "Interfaces",
        "order": 10,
        "action": {
            "type": "view",
            "path": "network/gateway-interfaces"
        },
        "depends": {
            "acl": [
                "luci-mod-network-config"
            ]
        }
    },
    "admin/network/routes": {
        "title": "Routing",
        "order": 20,
        "action": {
            "type": "view",
            "path": "routing/routes"
        },
        "depends": {
            "acl": [
                "luci-app-routing"
            ]
        }
    },
    "admin/network/dhcp": {
        "title": "DHCP and DNS",
        "order": 30,
        "action": {
            "type": "view",
            "path": "network/gateway-dhcp"
        },
        "depends": {
            "acl": [
                "luci-mod-network-dhcp"
            ],
            "fs": {
                "/usr/sbin/dnsmasq": "executable"
            },
            "uci": {
                "dhcp": true
            }
        }
    },
    "admin/network/diagnostics": {
        "title": "Diagnostics",
        "order": 80,
        "action": {
            "type": "view",
            "path": "network/diagnostics"
        },
        "depends": {
            "acl": [
                "luci-mod-network-diagnostics"
            ]
        }
    },
    "admin/network/lte": {
        "title": "LTE",
        "order": 50,
        "action": {
            "type": "view",
            "path": "lte/lte"
        }
    },
    "admin/network/firewall": {
        "title": "Firewall",
        "order": 70,
        "action": {
            "type": "alias",
            "path": "admin/network/firewall/zones"
        },
        "depends": {
            "acl": [
                "luci-app-firewall"
            ],
            "fs": {
                "/sbin/fw3": "executable"
            },
            "uci": {
                "firewall": true
            }
        }
    },
    "admin/network/multiwan": {
        "title": "MultiWAN",
        "order": 60,
        "action": {
            "type": "view",
            "path": "multiwan/multiwan"
        },
        "depends": {
            "acl": [
                "luci-app-multiwan"
            ]
        }
    },
    "admin/network/mwan3": {
        "depends": {
            "fs": {
                "/dev/null/hidden": "executable"
            }
        }
    }
}
